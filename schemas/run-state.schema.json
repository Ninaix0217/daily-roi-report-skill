{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/daily-roi/run-state.schema.json",
  "title": "Daily ROI current run state v1",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "stage", "input_dir", "output_dir", "manifest", "gates", "run_mappings"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["HUMAN_REQUIRED", "INFERRED_REVIEW", "READY_TO_WRITE", "COMPLETE", "VERIFICATION_FAILED"] },
    "stage": { "enum": ["DISCOVER", "PREFLIGHT", "RESOLVE", "RECONCILE", "WRITE", "VERIFY", "COMPLETE"] },
    "input_dir": { "type": "string" },
    "output_dir": { "type": "string" },
    "manifest": { "type": "array" },
    "gates": { "type": "array", "items": { "$ref": "human-gate.schema.json" } },
    "review_batch": { "oneOf": [{ "$ref": "review-batch.schema.json" }, { "type": "null" }] },
    "review_metrics": {
      "type": "object",
      "properties": {
        "review_accept_count": { "type": "integer", "minimum": 0 },
        "review_reject_count": { "type": "integer", "minimum": 0 },
        "review_correct_count": { "type": "integer", "minimum": 0 }
      }
    },
    "run_mappings": { "type": "object", "additionalProperties": { "type": "string" } },
    "audit": {
      "type": ["object", "null"],
      "properties": {
        "resolutions": { "type": "array", "items": { "$ref": "evidence-resolution.schema.json" } },
        "resolution_summary": {
          "type": "object",
          "properties": {
            "verified": { "type": "integer", "minimum": 0 },
            "machine_inferred": { "type": "integer", "minimum": 0 },
            "inferred_review": { "type": "integer", "minimum": 0 },
            "human_required": { "type": "integer", "minimum": 0 },
            "verified_count": { "type": "integer", "minimum": 0 },
            "inferred_review_count": { "type": "integer", "minimum": 0 },
            "human_required_count": { "type": "integer", "minimum": 0 },
            "open_ended_human_decisions": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
